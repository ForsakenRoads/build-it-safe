{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write)$|^mcp__",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.build-it-safe/guard.py\"",
            "timeout": 30,
            "statusMessage": "build-it-safe guard"
          }
        ]
      }
    ]
  }
}
