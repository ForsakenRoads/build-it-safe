{
  "description": "build-it-safe guard: blocks secret-file reads, destructive commands, curl | sh, skipped git hooks and literal keys in written files.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|PowerShell|Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob)$|^mcp__",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
